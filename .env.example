# Kopiere diese Datei zu .env und trage echte Werte ein. Niemals echte Secrets committen.

PORT=3000

# --- Headscale ---
HEADSCALE_URL=https://headscale.example.com
HEADSCALE_API_KEY=

# --- Keycloak (OIDC-Login) ---
KEYCLOAK_REALM_URL=https://auth.example.com/realms/internal
KEYCLOAK_CLIENT_ID=headpilot-dashboard
KEYCLOAK_CLIENT_SECRET=
# Wohin Keycloak nach dem Login zurückschicken soll - lokal z.B. http://localhost:3000/login/callback
REDIRECT_URI=https://your-domain.example.com/login/callback

# Starkes, zufälliges Secret für express-session (z.B. mit `openssl rand -hex 32` erzeugen)
SESSION_SECRET=

# true in Produktion (HTTPS vorhanden), false lokal ohne HTTPS
COOKIE_SECURE=false

# --- Uptime Kuma ("Status"-Reiter) ---
# Echter Login über Kumas Socket.IO-Schnittstelle (dieselbe, die auch das Kuma-Webinterface
# benutzt) - keine Status-Page/Slug nötig, zeigt direkt alle Monitore. Alle drei Variablen
# leer/nicht gesetzt lassen, wenn Kuma in dieser Umgebung nicht verfügbar sein soll -> die
# Status-Seite zeigt dann sauber "nicht konfiguriert" an, ganz ohne Netzwerk-Request.
# - Läuft Headpilot auf demselben Host wie Kuma (z.B. auf dem VPS): 127.0.0.1 verwenden.
# - Läuft Headpilot auf einem ANDEREN Gerät im Tailnet (z.B. lokal zum Testen): entweder
#   die Tailscale-IP des Kuma-Hosts (setzt voraus, dass Kumas Docker-Port nicht nur auf
#   127.0.0.1 gemappt ist), oder die öffentliche Domain, falls Caddy davor liegt.
KUMA_URL=http://127.0.0.1:3001
KUMA_USER=
KUMA_PASS=

# --- SSH-Zugangsdaten-Speicherung (Docker-Scan "Zugangsdaten speichern") ---
# Ohne dieses Secret bleibt die Speicher-Funktion deaktiviert (Docker-Scan mit manueller
# Eingabe funktioniert trotzdem). Pro Umgebung einen EIGENEN, zufälligen Wert setzen,
# z.B. mit `openssl rand -hex 32` - niemals zwischen Umgebungen wiederverwenden.
SSH_VAULT_SECRET=
